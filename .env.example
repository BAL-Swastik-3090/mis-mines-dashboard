############################################
# PRODUCTION DATABASE CONFIGURATION
############################################
DB_DRIVER=mysql+mysqlconnector
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306
DB_NAME=

############################################
# REDIS
############################################
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

############################################
# APPLICATION PORTS
############################################
FRONTEND_PORT=3333
BACKEND_PORT=8989

############################################
# APPLICATION
############################################
APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:3333

############################################
# AI / ML (Phase 4 & 5 — fill when ready)
############################################
ANTHROPIC_API_KEY=

############################################
# SAP (Phase later — fill when ready)
############################################
SAP_HOST=
SAP_CLIENT=
SAP_USER=
SAP_PASSWORD=
SAP_SYSNR=

############################################
# FIGMA MCP
############################################

# MineHub platform database (PostgreSQL). The MySQL above is a read-only
# source; everything the platform owns lives here.
PG_HOST=
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=
PG_SCHEMA=minehub
# prefer = use TLS when the server offers it; require = refuse to connect
# without it. Use require once the server has ssl = on.
PG_SSLMODE=prefer

# Face-recognition attendance (SmartFace, MSSQL). Read-only — the platform never
# writes to the attendance system. Leave FRS_HOST blank to turn it off.
FRS_HOST=
FRS_PORT=1433
FRS_DATABASE=SmartFace
FRS_USER=
FRS_PASSWORD=
