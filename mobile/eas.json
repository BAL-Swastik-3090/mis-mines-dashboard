{
  "cli": {
    "version": ">= 5.9.0",
    "appVersionSource": "local"
  },
  "build": {
    "trial": {
      "android": {
        "buildType": "apk"
      },
      "channel": "trial",
      "env": {
        "EXPO_PUBLIC_HOTO_API": "https://mines.balasorealloys.in"
      }
    },
    "trial-dev": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "channel": "trial-dev",
      "env": {
        "EXPO_PUBLIC_HOTO_API": "http://192.168.16.157:8990"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_HOTO_API": "https://mines.balasorealloys.in"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
