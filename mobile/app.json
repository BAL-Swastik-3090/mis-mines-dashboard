{
  "expo": {
    "name": "Kaliapani HOTO",
    "slug": "kaliapani-hoto",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "kaliapanihoto",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "in.balasorealloys.kaliapani.hoto",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "A photo is required for some checks — a cracked hose or a leaking seal is a defect the workshop can act on, where a tick is not.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Each handover records where it was captured, so a record can be tied to the machine it describes.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": false,
          "useSQLCipher": true
        }
      ],
      "expo-background-task",
      "expo-task-manager",
      "expo-asset",
      "expo-build-properties"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "9a050ab6-6e15-4952-a7a6-8bd97ebe1643"
      }
    },
    "owner": "balasore-alloys-limited"
  }
}
